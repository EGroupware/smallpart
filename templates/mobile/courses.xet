<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="smallpart.courses.rows" template="" lang="" group="0" version="19.1.001">
		<grid width="100%">
			<columns>
				<column width="15"/>
				<column width="50%"/>
				<column width="25%"/>
				<column width="25%"/>
				<column width="15"/>
			</columns>
			<rows>
				<row class="th">
					<nextmatch-sortheader label="#" id="course_id"/>
					<et2-nextmatch-header  label="Name" id="course_name"></et2-nextmatch-header>
					<et2-nextmatch-header-account  id="course_org" emptyLabel="Organization" accountType="groups"></et2-nextmatch-header-account>
					<et2-nextmatch-header-account  id="course_owner" emptyLabel="Owner" accountType="accounts"></et2-nextmatch-header-account>
					<et2-nextmatch-header  id="subscribed" label="Subscribed"></et2-nextmatch-header>
				</row>
				<row class="$row_cont[cat_id] $row_cont[class]">
					<et2-description  id="${row}[course_id]"></et2-description>
					<et2-description  id="${row}[course_name]"></et2-description>
					<et2-select-account  id="${row}[course_org]" readonly="true"></et2-select-account>
					<et2-select-account  id="${row}[course_owner]" readonly="true"></et2-select-account>
					<et2-checkbox  id="${row}[subscribed]" readonly="true"></et2-checkbox>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="smallpart.courses.add" template="" lang="" group="0" version="19.1.001">
		<et2-button-icon  id="add" class="plus_button" onclick="egw.open('', 'smallpart')" noSubmit="true" image="plus-lg" parentId="smallpart-courses_plus_button_container"></et2-button-icon>
	</et2-template>
	<et2-template  id="smallpart.courses" template="" lang="" group="0" version="19.1.001">
		<et2-description  id="plus_button_container"></et2-description>
		<nextmatch id="nm" options="smallpart.courses.rows" header_right="smallpart.courses.add" header_left="smallpart.courses.add"/>
	</et2-template>
</overlay>

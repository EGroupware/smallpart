<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
    <et2-template  id="smallpart.question.multiplechoice" template="" lang="" group="0" version="19.1.001">
        <et2-vbox>
            <et2-html  id="data"></et2-html>
            <et2-groupbox  summary="Answers">
                <grid id="answers" width="100%">
                    <columns>
                        <column width="30px"/>
                        <column/>
                        <column width="1px"/>
                    </columns>
                    <rows>
                        <row>
                            <et2-checkbox  id="${row}[check]" onchange="app.smallpart.checkMaxAnswers"></et2-checkbox>
                            <et2-label  value="$row_cont[answer]" for="${row}[check]"></et2-label>
                            <et2-hidden  id="${row}[id]"></et2-hidden>
                        </row>
                    </rows>
                </grid>
            </et2-groupbox>
        </et2-vbox>
    </et2-template>
</overlay>
